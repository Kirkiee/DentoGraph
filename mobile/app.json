{
  "expo": {
    "name": "DentoGraph",
    "slug": "dentograph-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/dentograph-favicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/dentograph-favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.dentograph.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/dentograph-favicon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ef2e126d-15a3-4e99-a23d-89b7039f7016"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}