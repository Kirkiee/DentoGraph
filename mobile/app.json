{
  "expo": {
    "name": "DentoGraph",
    "slug": "dentograph-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/dentograph-favicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/dentograph-favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.dentograph.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/dentograph-favicon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "DentoGraph uses the camera for the AR braces preview.",
        "NSLocationWhenInUseUsageDescription": "DentoGraph uses your location to show nearby dental clinics."
      }
    },
    "extra": {
      "eas": {
        "projectId": "ef2e126d-15a3-4e99-a23d-89b7039f7016"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DentoGraph to use your camera for AR braces previews.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DentoGraph to use your location to show nearby dental clinics."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow DentoGraph to securely access your saved session."
        }
      ]
    ]
  }
}